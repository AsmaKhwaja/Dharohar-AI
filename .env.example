# IBM watsonx.ai / Granite LLM Configuration
# Copy this file to .env and fill in your IBM Cloud credentials

# IBM Cloud API Key (from IAM → API Keys)
VITE_WATSONX_API_KEY=

# watsonx.ai Project ID (from your watsonx.ai project settings)
VITE_WATSONX_PROJECT_ID=

# watsonx.ai API endpoint (default: us-south)
VITE_WATSONX_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation

# IBM Granite model to use
VITE_GRANITE_MODEL=ibm/granite-13b-instruct-v2

# Force demo mode even if credentials are present (set to true for demos)
VITE_DEMO_MODE=false
